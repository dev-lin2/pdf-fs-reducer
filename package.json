    "lib",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pdf",
    "compress",
    "reduce",
    "filesize",
    "ghostscript",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ora": "^5.4.1"
  }
}
