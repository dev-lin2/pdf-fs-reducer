{
  "name": "pdf-fs-reducer",
  "version": "1.0.1",
  "description": "Reduce PDF file size with Ghostscript from CLI or JavaScript API.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
